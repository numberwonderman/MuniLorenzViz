
body {
    font-family: 'Inter', sans-serif;
    background-color: #0f172a;
    color: #e2e8f0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 100vh;
    padding: 1rem;
    overflow-x: hidden;
}

canvas {
    display: block;
    margin: 0 auto;
    border-radius: 0.75rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
    background-color: #000;
    width: 100%;
    height: 65vh;
    max-width: 900px;
}

.control-panel {
    background-color: #1e293b;
    padding: 1.5rem;
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    margin-bottom: 1.5rem;
    width: 100%;
    max-width: 900px;
    border: 1px solid #334155;
}

input[type="number"] {
    background-color: #334155;
    border: 1px solid #475569;
    color: #f8fafc;
    padding: 0.5rem;
    border-radius: 0.5rem;
}

.message-box {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background-color: rgba(30, 41, 59, 0.9);
    color: #818cf8;
    padding: 10px 20px;
    border-radius: 8px;
    z-index: 1000;
    display: none;
    border: 1px solid #4f46e5;
}

.toggle-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #334155;
    border: 1px solid #475569;
    color: #f8fafc;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    transition: all 0.2s;
    user-select: none;
}

.toggle-btn:hover { background-color: #475569; }
.toggle-btn.active { background-color: #4f46e5; border-color: #6366f1; }

.toggle-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #94a3b8;
}

.toggle-btn.active .toggle-indicator { background-color: #22d3ee; }
