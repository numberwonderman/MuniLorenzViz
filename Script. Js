let scene, camera, renderer, controls, attractorObject;
let lineState = true;
let twistMode = false; // For Dr. Muni's color-coded twist

const generateLorenzPath = (a, b, c, iterations) => {
    let x = 0.1, y = 0.1, z = 0.1;
    const points = [];
    const colors = [];
    
    // Accessibility Palettes
    const colorStart = new THREE.Color(0x6366f1); // Indigo
    const colorEnd = new THREE.Color(0x22d3ee);   // Cyan
    const twistColorPos = new THREE.Color(0xff0055); // Red-ish for twist
    const twistColorNeg = new THREE.Color(0x0055ff); // Blue-ish for counter-twist

    for (let i = 0; i < iterations; i++) {
        let nextX = y;
        let nextY = Math.sin(z);
        let nextZ = a + (b * x) + (c * y) - Math.sin(z * z);

        x = nextX; y = nextY; z = nextZ;
        points.push(new THREE.Vector3(x * 25, y * 25, z * 25));

        if (twistMode) {
            // Simplified "Twist" visualization: using Z-velocity as a proxy for now
            // We can replace this with full torsion formula later
            const twistFactor = Math.abs(z); 
            const vColor = new THREE.Color().copy(twistColorNeg).lerp(twistColorPos, twistFactor);
            colors.push(vColor.r, vColor.g, vColor.b);
        } else {
            const lerpFactor = i / iterations;
            const vColor = new THREE.Color().copy(colorStart).lerp(colorEnd, lerpFactor);
            colors.push(vColor.r, vColor.g, vColor.b);
        }
    }
    return { points, colors };
};

function buildAttractorObject(data) {
    const geometry = new THREE.BufferGeometry().setFromPoints(data.points);
    geometry.setAttribute('color', new THREE.Float32BufferAttribute(data.colors, 3));

    if (lineState) {
        const material = new THREE.LineBasicMaterial({ vertexColors: true, transparent: true, opacity: 0.8 });
        return new THREE.Line(geometry, material);
    } else {
        const material = new THREE.PointsMaterial({ vertexColors: true, size: 0.18, transparent: true, opacity: 0.9 });
        return new THREE.Points(geometry, material);
    }
}

function initThreeJS() {
    const canvas = document.getElementById('lorenzCanvas');
    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(75, canvas.clientWidth / canvas.clientHeight, 0.1, 1000);
    camera.position.set(20, 20, 40);

    renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    renderer.setPixelRatio(window.devicePixelRatio);

    controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    scene.add(new THREE.AxesHelper(5));

    window.addEventListener('resize', () => {
        const w = canvas.parentElement.clientWidth;
        const h = window.innerHeight * 0.65;
        renderer.setSize(w, h);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
    });
}

function render() {
    const a = parseFloat(document.getElementById('paramA').value);
    const b = parseFloat(document.getElementById('paramB').value);
    const c = parseFloat(document.getElementById('paramC').value);
    const iters = parseInt(document.getElementById('iterCount').value);

    if (attractorObject) {
        scene.remove(attractorObject);
        attractorObject.geometry.dispose();
        attractorObject.material.dispose();
    }

    const data = generateLorenzPath(a, b, c, iters);
    attractorObject = buildAttractorObject(data);
    scene.add(attractorObject);
}

document.addEventListener('DOMContentLoaded', () => {
    initThreeJS();
    
    document.getElementById('generateBtn').addEventListener('click', render);
    
    document.getElementById('toggleModeBtn').addEventListener('click', (e) => {
        lineState = !lineState;
        e.currentTarget.classList.toggle('active');
        document.getElementById('toggleLabel').textContent = lineState ? 'Lines' : 'Points';
        if (attractorObject) render();
    });

    document.getElementById('toggleTwistBtn').addEventListener('click', (e) => {
        twistMode = !twistMode;
        e.currentTarget.classList.toggle('active');
        if (attractorObject) render();
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
        if (attractorObject) {
            scene.remove(attractorObject);
            attractorObject = null;
        }
    });

    function animate() {
        requestAnimationFrame(animate);
        controls.update();
        renderer.render(scene, camera);
    }
    animate();
});
