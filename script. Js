/**
 * script.js - Optimized for Boyer 109 Presentation
 */

import { generateLorenzPath } from './sandbox.js';

let scene, camera, renderer, controls, attractorObject;
let lineState = true;
let twistMode = false;

// Configuration for Torsion Colors (Matches your blue/orange "Intergalactic" aesthetic)
const twistColorNeg = new THREE.Color(0x0077ff); // Deep Blue
const twistColorPos = new THREE.Color(0xff7700); // Bright Orange
const epsilon = 1e-9;

function initThreeJS() {
    const canvas = document.getElementById('lorenzCanvas');
    if (!canvas) return;

    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(75, canvas.clientWidth / canvas.clientHeight, 0.1, 1000);
    camera.position.set(30, 30, 30);

    renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });
    renderer.setSize(canvas.clientWidth, canvas.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); // Cap pixel ratio for performance

    controls = new THREE.OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    
    scene.add(new THREE.AxesHelper(5));
}

function buildAttractorObject(data) {
    // Scaling points by 25 for better visibility in the Three.js coordinate space
    const threePoints = data.points.map(p => new THREE.Vector3(p.x * 25, p.y * 25, p.z * 25));
    
    const geometry = new THREE.BufferGeometry().setFromPoints(threePoints);
    geometry.setAttribute('color', new THREE.Float32BufferAttribute(data.colors, 3));

    const materialParams = { 
        vertexColors: true, 
        transparent: true, 
        opacity: 0.8 
    };

    if (lineState) {
        return new THREE.Line(geometry, new THREE.LineBasicMaterial(materialParams));
    } else {
        return new THREE.Points(geometry, new THREE.PointsMaterial({ ...materialParams, size: 0.15 }));
    }
}

function renderAttractor() {
    const a = parseFloat(document.getElementById('paramA').value) || 0;
    const b = parseFloat(document.getElementById('paramB').value) || 0;
    const c = parseFloat(document.getElementById('paramC').value) || 0;
    const iters = parseInt(document.getElementById('iterCount').value) || 5000;

    if (attractorObject) {
        scene.remove(attractorObject);
        attractorObject.geometry.dispose();
        attractorObject.material.dispose();
    }

    // Call the sandbox generator
    const data = generateLorenzPath(a, b, c, iters, twistMode);

    attractorObject = buildAttractorObject(data);
    scene.add(attractorObject);
}

// Ensure the DOM is fully loaded
window.onload = () => {
    initThreeJS();

    const genBtn = document.getElementById('generateBtn');
    if (genBtn) genBtn.onclick = renderAttractor;

    const twistBtn = document.getElementById('toggleTwistBtn');
    if (twistBtn) {
        twistBtn.onclick = () => {
            twistMode = !twistMode;
            twistBtn.classList.toggle('active');
            renderAttractor();
        };
    }

    const toggleBtn = document.getElementById('toggleModeBtn');
    if (toggleBtn) {
        toggleBtn.onclick = () => {
            lineState = !lineState;
            const label = document.getElementById('toggleLabel');
            if (label) label.textContent = lineState ? 'Lines' : 'Points';
            renderAttractor();
        };
    }

    function animate() {
        requestAnimationFrame(animate);
        if (controls) controls.update();
        if (renderer && scene && camera) renderer.render(scene, camera);
    }
    animate();
};